<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><Version>0.9.0</Version></PropertyGroup>
  <ItemGroup>
    <Compile Include="../JarvisHud/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../JarvisHud/Gateway/*.cs" Link="Gateway/%(Filename)%(Extension)" />
    <Compile Include="../JarvisHud/Homelab/*.cs" Link="Homelab/%(Filename)%(Extension)" />
    <Compile Include="../JarvisHud/Audio/*.cs" Link="Audio/%(Filename)%(Extension)" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <Content Include="../JarvisHud/Homelab/*.py" Link="Homelab/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../examples/demo-snapshot.json" Link="Homelab/demo-snapshot.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
